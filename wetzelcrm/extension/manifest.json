{
  "manifest_version": 3,
  "name": "Personal CRM",
  "version": "1.1.0",
  "description": "Extract LinkedIn contact info and save to WetzelCRM",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://wetzelwest.com/*",
    "https://crm.wetzelwest.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal CRM"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
